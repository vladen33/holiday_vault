{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/vladen33/holiday_vault/data/contests.schema.json",
  "title": "Конкурсы для праздника",
  "type": "object",
  "required": ["schemaVersion", "title", "updated", "types", "audiences", "contests"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "types": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/type" }
    },
    "audiences": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/audience" }
    },
    "contests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/contest" }
    }
  },
  "definitions": {
    "type": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "icon": { "type": "string" },
        "order": { "type": "integer" }
      }
    },
    "audience": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "order": { "type": "integer" }
      }
    },
    "contest": {
      "type": "object",
      "required": [
        "id", "title", "type", "audiences", "minAge", "duration",
        "players", "format", "props", "tags", "description", "rules", "tip"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "audiences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9_-]+$" }
        },
        "minAge": { "type": "integer", "minimum": 0, "maximum": 18 },
        "duration": { "type": "integer", "minimum": 1 },
        "players": { "type": "string", "minLength": 1 },
        "format": { "enum": ["individual", "team", "pair"] },
        "props": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "description": { "type": "string", "minLength": 1 },
        "rules": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1 }
        },
        "tip": { "type": "string", "minLength": 1 }
      }
    }
  }
}
