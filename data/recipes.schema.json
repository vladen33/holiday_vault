{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/vladen33/holiday_vault/data/recipes.schema.json",
  "title": "Рецепты праздничного стола",
  "type": "object",
  "required": ["schemaVersion", "title", "updated", "categories", "holidays", "recipes"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/category" }
    },
    "holidays": {
      "type": "array",
      "items": { "$ref": "#/definitions/holiday" }
    },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/recipe" }
    }
  },
  "definitions": {
    "category": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "icon": { "type": "string" },
        "order": { "type": "integer" }
      }
    },
    "holiday": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "ingredient": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "amount": { "type": ["number", "null"], "minimum": 0 },
        "unit": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "recipe": {
      "type": "object",
      "required": [
        "id", "title", "category", "holidays", "description",
        "servings", "time", "ingredients", "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "holidays": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9_-]+$" }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "description": { "type": "string", "minLength": 1 },
        "servings": { "type": "integer", "minimum": 1 },
        "yield": { "type": "string" },
        "time": {
          "type": "object",
          "required": ["prep", "cook"],
          "additionalProperties": false,
          "properties": {
            "prep": { "type": "integer", "minimum": 0 },
            "cook": { "type": "integer", "minimum": 0 }
          }
        },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "allergens": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "storage": { "type": "string" },
        "ingredients": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/ingredient" }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "tips": { "type": "string" },
        "image": { "type": "string" }
      }
    }
  }
}
